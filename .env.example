# Mẫu cấu hình. Chép thành .env rồi điền giá trị (lc_app/config.py nạp .env ở thư mục gốc).

# --- Bắt buộc ---
OPENAI_API_KEY=
# docker-compose.yml cũng đọc NEO4J_PASSWORD khi tạo database
NEO4J_PASSWORD=

# --- Tùy chọn (giá trị dưới đây là mặc định trong code) ---
# Mô hình sinh câu trả lời
OPENAI_GENERATION_MODEL=gpt-4o-mini
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Ghi đè cấu hình thí nghiệm khi cần (bỏ comment):
# LC_RETRIEVAL_MODE=hybrid-rrf       # dense | bm25 | hybrid-rrf | graph-augmented-hybrid | graph-global
# LC_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
# LC_CONTEXT_CHARS=8000
# LC_GRAPH_DIR=data/chunk/chunk_v1/clean_chunk_v1/graph_full
# LC_GRAPH_MODEL=gpt-4o-mini
